{
    "name": "prepmock/jambura-core",
    "description": "Lightweight PHP MVC framework",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jambura\\Mvc\\": "src/mvc/",
            "Jambura\\LLM\\": "src/llm/",
            "AIModel\\": "src/aimodel/"
        },
        "classmap": [
            "src/llm.php"
        ],
        "files": [
            "src/helpers/jassets.php",
            "src/helpers/jcontroller.php",
            "src/helpers/jcache.php", 
            "src/helpers/jexceptions.php", 
            "src/helpers/jflash.php",
            "src/helpers/jmodel.php",
            "src/helpers/jrouter.php",
            "src/jambura.php"
        ]
    },
    "authors": [
        {
            "name": "Kamrul Khan"
        }
    ],
    "require": {
        "prepmock/idiorm": "^2.0",
        "robmorgan/phinx": "^0.16",
        "php": ">=8.1"
    },
    "suggest": {
        "anthropic-ai/sdk": "Required by the AIModel\\Claude adapter, with a PSR-18 HTTP client such as guzzlehttp/guzzle",
        "ext-curl": "Required by the AIModel\\Deepseek adapter"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "anthropic-ai/sdk": "^0.48.0",
        "guzzlehttp/guzzle": "^8.2"
    }
}
